# E2E Test Environment Configuration
# Copy this file to .env.e2e and fill in the values

# Server URLs
E2E_BASE_URL=http://localhost:3001
E2E_API_URL=http://localhost:3000

# Test User Credentials (uses seeded users from db:seed)
# SUPER_ADMIN - Diskominfo Admin
E2E_USER_SUPER_ADMIN_EMAIL=admin@bandung.go.id
E2E_USER_SUPER_ADMIN_PASSWORD=password123

# OPERATOR - OPD Staff
E2E_USER_OPERATOR_EMAIL=operator.diskominfo@bandung.go.id
E2E_USER_OPERATOR_PASSWORD=password123

# AUDITOR - Inspektorat
E2E_USER_AUDITOR_EMAIL=auditor@bandung.go.id
E2E_USER_AUDITOR_PASSWORD=password123

# LEADER - Executive
E2E_USER_LEADER_EMAIL=pimpinan@bandung.go.id
E2E_USER_LEADER_PASSWORD=password123

# CI/CD Mode (set to true in CI environment)
CI=false
