{
  "name": "simapbe",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^5",
      "@types/bun": "^1.3.4",
      "@trpc/server": "^11.7.2",
      "better-auth": "^1.4.9",
      "@prisma/client": "^7.1.0",
      "@trpc/client": "^11.7.2",
      "elysia": "^1.3.21"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @simapbe/db db:push",
    "db:studio": "turbo -F @simapbe/db db:studio",
    "db:generate": "turbo -F @simapbe/db db:generate",
    "db:migrate": "turbo -F @simapbe/db db:migrate",
    "db:reset": "turbo -F @simapbe/db db:reset",
    "prepare": "husky",
    "ruler:apply": "bunx @intellectronica/ruler@latest apply --local-only"
  },
  "dependencies": {
    "@simapbe/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:",
    "elysia": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@simapbe/config": "workspace:*",
    "@types/bun": "catalog:",
    "husky": "latest",
    "lint-staged": "latest",
    "turbo": "^2.6.3",
    "typescript": "catalog:",
    "ultracite": "7.0.7"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun x ultracite fix"
    ]
  },
  "packageManager": "bun@1.3.3"
}
